# Aplicação
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/crm_gestao_escolar

# Sessão
SESSION_SECRET=GERE_UMA_CHAVE_LONGA_E_ALEATORIA
SESSION_IDLE_MINUTES=30

# Usuário administrador inicial
ADMIN_EMAIL=admin@colegiohorizonte.local
ADMIN_PASSWORD=SENHA_FORTE

# Backup automático
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_TIME=19:00

# Identidade da instituição (use dados fictícios em ambientes de demonstração)
ESCOLA_NOME=Instituicao_de_Ensino_Demo
ESCOLA_CNPJ=00.000.000/0000-00
ESCOLA_ENDERECO=Endereco_de_demonstracao
ESCOLA_REPRESENTANTE=Representante_Demo
ESCOLA_TELEFONE=(00)_00000-0000
